---
import MainLayout from './MainLayout.astro';

interface Props {
  title: string;
  description: string;
  publishDate?: string;
  readTime?: string;
  ogImage?: string;
}

const { title, description, publishDate = "July 2026", readTime = "5 min read", ogImage } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<MainLayout title={`${title} | CharCraft Articles`} description={description} ogImage={ogImage} activePath="articles">
  <article class="article-content">
    <header class="article-header">
      <a href={baseUrl} class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Home
      </a>
      
      <div class="meta-row">
        <span class="meta-tag">{publishDate}</span>
        <span class="meta-separator">•</span>
        <span>{readTime}</span>
      </div>

      <h1 class="article-title">{title}</h1>
      <p class="article-subtitle">{description}</p>
    </header>

    <div class="glass-card article-card-body">
      <div class="markdown-body">
        <slot />
      </div>
    </div>
  </article>
</MainLayout>

<style>
  .article-content {
    max-width: 800px;
    margin: 0 auto;
    padding: 1rem 0 3rem 0;
  }

  .article-header {
    margin-bottom: 2rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--secondary);
    font-weight: 500;
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .back-link:hover {
    color: var(--secondary-hover);
    transform: translateX(-4px);
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-bottom: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .meta-tag {
    color: var(--primary);
  }

  .meta-separator {
    color: var(--border-color);
  }

  .article-title {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 1rem;
    line-height: 1.15;
  }

  .article-subtitle {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--text-muted);
    line-height: 1.5;
  }

  .article-card-body {
    padding: 2.5rem;
    border-color: var(--border-color);
  }

  /* Reading Typography */
  .markdown-body :global(p) {
    margin-bottom: 1.5rem;
    font-size: 1.1rem;
    line-height: 1.75;
    color: hsl(240, 5%, 90%);
  }

  .markdown-body :global(h2) {
    font-size: 1.6rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--text-main);
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.4rem;
  }

  .markdown-body :global(h3) {
    font-size: 1.25rem;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--secondary);
  }

  .markdown-body :global(ul), .markdown-body :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .markdown-body :global(li) {
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
    line-height: 1.75;
    color: hsl(240, 5%, 90%);
  }

  .markdown-body :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.75rem 1.25rem;
    border-left: 4px solid var(--primary);
    background: rgba(139, 92, 246, 0.05);
    border-radius: 0 0.5rem 0.5rem 0;
  }

  .markdown-body :global(blockquote p) {
    margin-bottom: 0;
    font-style: italic;
    color: var(--text-muted);
  }

  .markdown-body :global(pre) {
    background: rgba(10, 10, 12, 0.8) !important;
    border: 1px solid var(--border-color);
    border-radius: 0.5rem;
    padding: 1.25rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }

  .markdown-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: rgba(255, 255, 255, 0.08);
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
  }

  .markdown-body :global(pre code) {
    background: none;
    padding: 0;
    font-size: 0.95em;
  }
</style>
